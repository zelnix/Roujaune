{
  "expo": {
    "name": "Roujaune",
    "slug": "roujaune",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "roujaune",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.hwg.roujaune",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Find nearby TVs to cast your ride",
        "NSBonjourServices": [
          "_googlecast._tcp",
          "_airplay._tcp"
        ],
        "NSPhotoLibraryUsageDescription": "Set your rider profile photo",
        "NSPhotoLibraryAddUsageDescription": "Save your achievement cards to Photos",
        "NSBluetoothAlwaysUsageDescription": "Connect your trainer and heart-rate sensor",
        "NSLocationWhenInUseUsageDescription": "Show local weather for today's ride",
        "NSHealthShareUsageDescription": "Import your cycling rides",
        "NSHealthUpdateUsageDescription": "Save your rides to Health",
        "LSApplicationQueriesSchemes": [
          "nflx",
          "primevideo",
          "aiv",
          "disneyplus",
          "videos",
          "com.apple.tv",
          "youtube",
          "vnd.youtube"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.WRITE_DISTANCE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.WRITE_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.WRITE_HEART_RATE"
      ],
      "package": "com.hwg.roujaune",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFC20A"
        }
      ],
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845",
          "iosStartDiscoveryAfterFirstTapOnCastButton": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Set your rider profile photo"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Connect your trainer and heart-rate sensor"
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "Roujaune reads your cycling rides to show your history.",
          "healthUpdatePermission": "Roujaune saves your completed rides to Apple Health."
        }
      ],
      "react-native-health-connect",
      "expo-mail-composer",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.100157698823-0cc8mq63uan5cenfgqeoo049ushvqlk0"
        }
      ],
      "./plugins/withChromeOsCompat",
      "expo-asset",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "react-native-share",
        {
          "ios": ["instagram", "instagram-stories"],
          "android": ["com.instagram.android"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}